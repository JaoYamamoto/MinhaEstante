# Copie este arquivo para .env.local e preencha os valores
# cp .env.local.example .env.local

# URL do backend Flask
# Desenvolvimento: http://localhost:5000
# Produção:        https://seu-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# EmailJS — obtidas em emailjs.com > Account > API Keys
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=

# Google Books API — opcional, aumenta o limite de requisições
# Obtenha em: console.cloud.google.com > APIs > Google Books API
GOOGLE_BOOKS_API_KEY=
