# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# Chave secreta do Flask — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_secreta_aleatoria

# Banco de dados (SQLite local ou URL externa)
DATABASE_URL=sqlite:///minha_estante.db

# URL do frontend (sem barra no final)
# Desenvolvimento: http://localhost:3000
# Produção:        https://seu-app.vercel.app
FRONTEND_ORIGIN=http://localhost:3000
